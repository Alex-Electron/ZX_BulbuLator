# macOS / YandexDisk junk
.DS_Store
._*

# Fetched dependencies (run ./get_deps.sh) and per-step assembled build trees.
# These are reproducible from get_deps.sh + each step's assemble.sh, never committed.
/cores/
/deps/
build/

# Fetched ROM (run a step's get_rom.sh) — build inputs, regenerated, never committed.
rom128.hex
combined128.rom
*.rom

# Шаг 15: наборы ПЗУ выложены НАМЕРЕННО, вместе с описанием происхождения
# (research/15-pentagon/roms/PROVENANCE.md: кто автор, откуда взято, что мы меняли).
!research/15-pentagon/roms/*.ROM
!research/15-pentagon/roms/*.BIN

# Build artifacts of the .z80 snapshot injector (zxinj): the embedded blob is
# generated from your own snapshot, the ELF is compiled. Snapshots aren't shipped.
zxinj/z80_blob.c
zxinj/snapshot.z80
zxinj/zxinj.elf
# Generated PCAP "armoured train" input (bootgen -process_bitstream bin from the .bit).
*.bit.bin
# Шаг 15: готовые ядра публикуются НАМЕРЕННО — это то, что кладётся на карту памяти.
!research/15-pentagon/bitstreams/*.bit.bin

# Vivado / Vitis build artifacts.
# This repo commits only sources and prebuilt bitstreams; the full projects are
# built elsewhere, so the generated project tree never needs to land here.
*.jou
*.log
*.str
.Xil/
*.cache/
*.hw/
*.runs/
*.gen/
*.sim/
*.ip_user_files/
*.dcp
*.xpr
*.xsa
# Step 15: the hardware handoff the ARM BSP is generated from is published on purpose
!research/15-pentagon/arm/bsp/ebaz4205_ps7.xsa
# Generated Vitis workspace (research/15-pentagon/arm/bsp/make_bsp.sh output)
research/15-pentagon/arm/bsp/ws/
xsim.dir/
webtalk*.jou
webtalk*.log
usage_statistics_webtalk*
.jobs/

# Intentionally NOT ignored (these are the point of the repo):
#   *.bit / *.bin  — bitstreams and boot images
#   *.uf2          — Pico firmware
#   *.v *.sv *.vhd — HDL sources
#   *.xdc          — constraints
#   *.tcl *.sh     — build/flash scripts
#   *.hex          — memory init / ROM images

# Local-only files, not part of the published project
.cbmignore
docs/images/splash_orig.jpg
research/JTAG.md
# Step 16 is not published yet; its working tree stays local until it is
research/16-web-kvm/

# Python bytecode
__pycache__/
*.pyc
