xilffs v5.0 (Vitis 2023.1): on a failed polled read or write, re-initialise
the SD host and card once and retry before returning RES_ERROR.

Recovers from a card that dropped out of transfer state (for example after a
JTAG processor restart) without a full reboot. build_loader.sh compiles its
own copy of this diskio.c (diskio_bulb.c) and adds ../xilffs_diskio_ready_guard.patch
on top, so this patch must be applied before build_loader.sh runs.

Apply from <domain>/bsp/ps7_cortexa9_0/libsrc with: patch -p1
--- a/xilffs_v5_0/src/diskio.c
+++ b/xilffs_v5_0/src/diskio.c
@@ -368,7 +368,13 @@
 
 	Status  = XSdPs_ReadPolled(&SdInstance[pdrv], (u32)LocSector, count, buff);
 	if (Status != XST_SUCCESS) {
-		return RES_ERROR;
+		XSdPs_Config *SdConfig = XSdPs_LookupConfig((u16)pdrv);
+		XSdPs_CfgInitialize(&SdInstance[pdrv], SdConfig, SdConfig->BaseAddress);
+		XSdPs_CardInitialize(&SdInstance[pdrv]);
+		Status  = XSdPs_ReadPolled(&SdInstance[pdrv], (u32)LocSector, count, buff);
+		if (Status != XST_SUCCESS) {
+			return RES_ERROR;
+		}
 	}
 #endif
 
@@ -538,7 +544,13 @@
 
 	Status  = XSdPs_WritePolled(&SdInstance[pdrv], (u32)LocSector, count, buff);
 	if (Status != XST_SUCCESS) {
-		return RES_ERROR;
+		XSdPs_Config *SdConfig = XSdPs_LookupConfig((u16)pdrv);
+		XSdPs_CfgInitialize(&SdInstance[pdrv], SdConfig, SdConfig->BaseAddress);
+		XSdPs_CardInitialize(&SdInstance[pdrv]);
+		Status  = XSdPs_WritePolled(&SdInstance[pdrv], (u32)LocSector, count, buff);
+		if (Status != XST_SUCCESS) {
+			return RES_ERROR;
+		}
 	}
 
 #endif
